{
  "name": "@dotrino/vault",
  "version": "0.88.1",
  "description": "La bóveda de Dotrino como librería: el MISMO núcleo que el binario corriendo en el navegador (`@dotrino/vault/browser`), el mostrador de emparejamiento y el cliente de SERVICIO (Node): un proyecto se enrola una vez y jala sus credenciales del vault en vez del .env (`import '@dotrino/vault/config'`).",
  "type": "module",
  "main": "src/index.js",
  "module": "src/index.js",
  "bin": {
    "dotrino-env": "bin/dotrino-env.js"
  },
  "exports": {
    "./bin/dotrino-env.js": "./bin/dotrino-env.js",
    ".": {
      "import": "./src/index.js"
    },
    "./browser": {
      "import": "./src/browser.js"
    },
    "./service": {
      "import": "./src/service.js"
    },
    "./env": {
      "import": "./src/env.js"
    },
    "./config": {
      "import": "./src/config.js"
    },
    "./sealed": {
      "import": "./src/sealed.js"
    },
    "./invite": {
      "import": "./src/invite.js"
    },
    "./protocol": {
      "import": "./src/protocol.js"
    },
    "./password-logins": {
      "import": "./src/passwordLogins.js"
    },
    "./login-client": {
      "import": "./src/loginClient.js"
    },
    "./admin": {
      "import": "./src/admin.js"
    },
    "./device-info": {
      "import": "./src/deviceInfo.js"
    }
  },
  "files": [
    "src",
    "bin",
    "README.md",
    "LICENSE",
    "!src/types.d.ts"
  ],
  "keywords": [
    "dotrino",
    "vault",
    "identity",
    "delegation",
    "pairing"
  ],
  "peerDependencies": {
    "@dotrino/identity": ">=0.118.0",
    "@dotrino/proxy-client": ">=0.36.1",
    "@dotrino/store": ">=0.11.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imdotrino/dotrino-vault.git",
    "directory": "lib"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "5.9.3"
  },
  "scripts": {
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@dotrino/compat": "0.4.0",
    "@dotrino/opaque": "0.1.0",
    "@dotrino/passmanager": "0.18.3",
    "@dotrino/roadmap": "0.4.26",
    "@dotrino/update": "0.5.1"
  },
  "peerDependenciesMeta": {
    "@dotrino/store": {
      "optional": true
    }
  }
}
